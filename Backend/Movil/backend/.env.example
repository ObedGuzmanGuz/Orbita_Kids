# Copia este archivo como .env y ajusta los valores. Nunca subas .env al repositorio.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Orígenes permitidos para CORS (separados por coma). La app móvil no lo necesita;
# sirve para la versión web de Flutter.
CORS_ORIGINS=http://localhost:5000

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=orbita
DB_PASSWORD=orbita_dev
DB_NAME=orbita_kids
DB_CONNECTION_LIMIT=10

# ---------- Autenticación ----------
# keycloak: valida el access token contra el JWKS del realm (producción).
# dev:      acepta "Authorization: Bearer dev:<id-de-usuario>" para usuarios ya
#           sembrados con `npm run db:seed`. Prohibido con NODE_ENV=production.
AUTH_MODE=dev

KEYCLOAK_ISSUER=https://auth.tu-dominio/realms/orbita
# Si se define, el claim `azp` del token debe coincidir (cliente de la app).
KEYCLOAK_CLIENT_ID=orbita-kids-app
KEYCLOAK_ROLE_STUDENT=student
KEYCLOAK_ROLE_TEACHER=teacher

# ---------- Reglas de negocio ----------
# Días de vigencia de un código de grupo nuevo o regenerado.
GROUP_CODE_TTL_DAYS=180
