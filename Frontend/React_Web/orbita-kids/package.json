{
  "name": "orbita-kids",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch --disable-warning=ExperimentalWarning server/index.js --dev",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "preview": "npm run build && npm start",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/**/*.test.js\"",
    "db:reset": "node --disable-warning=ExperimentalWarning server/reset.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource-variable/red-hat-display": "^5.3.0",
    "@fontsource-variable/red-hat-text": "^5.3.0",
    "@fontsource/red-hat-mono": "^5.3.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
